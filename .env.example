# Copie para .env. O arquivo só é lido em desenvolvimento e nunca se sobrepõe
# a uma variável já definida no ambiente.

# development | staging | production
CM_ENV=development
CM_HTTP_ADDR=:8080

# sqlite (padrão local) ou postgres
CM_DB_DRIVER=sqlite
CM_DB_URL=click_money.db
# No PostgreSQL, as migrações usam um usuário próprio:
# CM_MIGRATE_DB_URL=postgres://click_money_migrate:senha@localhost:5432/click_money

# Origens aceitas pelo CORS, separadas por vírgula
CM_ALLOWED_ORIGINS=http://localhost:5173

# debug | info | warn | error
CM_LOG_LEVEL=info
CM_MAX_BODY_BYTES=1048576
CM_SHUTDOWN_TIMEOUT=20s
